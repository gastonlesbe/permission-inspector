    <!-- Permission catalog (name + plain-language description) -->
    <string name="perm_camera">Camera</string>
    <string name="perm_camera_desc">Can take photos and record video at any time while the app is open.</string>
    <string name="perm_record_audio">Microphone</string>
    <string name="perm_record_audio_desc">Can record audio — used for voice messages, calls, or background listening.</string>
    <string name="perm_access_fine_location">Location (precise)</string>
    <string name="perm_access_fine_location_desc">Knows your exact GPS position. Can track you to within a few meters.</string>
    <string name="perm_access_coarse_location">Location (approximate)</string>
    <string name="perm_access_coarse_location_desc">Knows your general area (city/neighborhood level) via Wi-Fi or cell towers.</string>
    <string name="perm_access_background_location">Location (always — background)</string>
    <string name="perm_access_background_location_desc">Tracks your location even when the app is not open or in use.</string>
    <string name="perm_read_contacts">Contacts (read)</string>
    <string name="perm_read_contacts_desc">Can read your full contact list including names, phones, and emails.</string>
    <string name="perm_write_contacts">Contacts (write)</string>
    <string name="perm_write_contacts_desc">Can add, edit, or delete entries in your contact list.</string>
    <string name="perm_read_call_log">Call log (read)</string>
    <string name="perm_read_call_log_desc">Can see your full call history — who you called and when.</string>
    <string name="perm_write_call_log">Call log (write)</string>
    <string name="perm_write_call_log_desc">Can add or modify entries in your call history.</string>
    <string name="perm_call_phone">Make phone calls</string>
    <string name="perm_call_phone_desc">Can dial phone numbers and make calls without asking you first.</string>
    <string name="perm_read_sms">Read SMS</string>
    <string name="perm_read_sms_desc">Can read all your text messages.</string>
    <string name="perm_send_sms">Send SMS</string>
    <string name="perm_send_sms_desc">Can send text messages from your number — potentially costing you money.</string>
    <string name="perm_receive_sms">Receive SMS</string>
    <string name="perm_receive_sms_desc">Can intercept incoming text messages before you see them.</string>
    <string name="perm_read_external_storage">Storage (read)</string>
    <string name="perm_read_external_storage_desc">Can read all files, photos, and documents on your device.</string>
    <string name="perm_write_external_storage">Storage (write)</string>
    <string name="perm_write_external_storage_desc">Can create, edit, or delete files on your device storage.</string>
    <string name="perm_read_media_images">Photos</string>
    <string name="perm_read_media_images_desc">Can access all photos stored on your device.</string>
    <string name="perm_read_media_video">Videos</string>
    <string name="perm_read_media_video_desc">Can access all video files stored on your device.</string>
    <string name="perm_read_media_audio">Audio files</string>
    <string name="perm_read_media_audio_desc">Can access all music and audio files on your device.</string>
    <string name="perm_body_sensors">Body sensors</string>
    <string name="perm_body_sensors_desc">Can read data from health sensors like heart rate monitors.</string>
    <string name="perm_activity_recognition">Physical activity</string>
    <string name="perm_activity_recognition_desc">Can detect when you are walking, running, cycling, or in a vehicle.</string>
    <string name="perm_use_biometric">Biometrics</string>
    <string name="perm_use_biometric_desc">Can request fingerprint or face authentication.</string>
    <string name="perm_bluetooth">Bluetooth</string>
    <string name="perm_bluetooth_desc">Can connect to and communicate with nearby Bluetooth devices.</string>
    <string name="perm_bluetooth_scan">Bluetooth scan</string>
    <string name="perm_bluetooth_scan_desc">Can scan for nearby Bluetooth devices — can be used to infer location.</string>
    <string name="perm_bluetooth_connect">Bluetooth connect</string>
    <string name="perm_bluetooth_connect_desc">Can connect to paired Bluetooth devices.</string>
    <string name="perm_internet">Internet</string>
    <string name="perm_internet_desc">Can send and receive data over the internet.</string>
    <string name="perm_access_wifi_state">Wi-Fi state</string>
    <string name="perm_access_wifi_state_desc">Can see which Wi-Fi networks are nearby — can be used to infer location.</string>
    <string name="perm_post_notifications">Notifications</string>
    <string name="perm_post_notifications_desc">Can show notifications on your screen and notification bar.</string>
    <string name="perm_vibrate">Vibrate</string>
    <string name="perm_vibrate_desc">Can make your phone vibrate — typically for notifications.</string>
    <string name="perm_receive_boot_completed">Start on boot</string>
    <string name="perm_receive_boot_completed_desc">Can launch itself automatically every time you restart your phone.</string>
    <string name="perm_foreground_service">Foreground service</string>
    <string name="perm_foreground_service_desc">Can run persistently in the background with a visible notification.</string>
    <string name="perm_use_fingerprint">Fingerprint</string>
    <string name="perm_use_fingerprint_desc">Can request fingerprint authentication.</string>
    <string name="perm_flashlight">Flashlight</string>
    <string name="perm_flashlight_desc">Can turn the camera flash LED on and off.</string>
    <string name="perm_nfc">NFC</string>
    <string name="perm_nfc_desc">Can read and write data via Near Field Communication (tap-to-pay, etc.).</string>
    <string name="perm_read_phone_state">Phone state</string>
    <string name="perm_read_phone_state_desc">Can read your phone number, network info, and unique device identifiers.</string>
    <string name="perm_process_outgoing_calls">Outgoing calls</string>
    <string name="perm_process_outgoing_calls_desc">Can see the number you are dialing before the call connects.</string>
    <string name="perm_schedule_exact_alarm">Exact alarms</string>
    <string name="perm_schedule_exact_alarm_desc">Can schedule tasks to run at precise times, even in the background.</string>
    <string name="perm_use_exact_alarm">Exact alarms</string>
    <string name="perm_use_exact_alarm_desc">Can set exact alarms — used for reminders and scheduled tasks.</string>
    <string name="perm_manage_external_storage">Full storage access</string>
    <string name="perm_manage_external_storage_desc">Can access ALL files on your device, including system folders.</string>
    <string name="perm_system_alert_window">Draw over other apps</string>
    <string name="perm_system_alert_window_desc">Can show content on top of any other app on your screen.</string>
    <string name="perm_get_accounts">Account list</string>
    <string name="perm_get_accounts_desc">Can see all Google and other accounts linked to your device.</string>
    <string name="perm_write_calendar">Calendar (write)</string>
    <string name="perm_write_calendar_desc">Can create, edit, or delete calendar events.</string>
    <string name="perm_read_calendar">Calendar (read)</string>
    <string name="perm_read_calendar_desc">Can read all your calendar events and appointments.</string>
</resources>
