<resources>
    <!-- API 35+ copy of Theme.PermissionInspector from values/themes.xml: identical except it
         also sets android:windowOptOutEdgeToEdgeEnforcement (requires API 35; minSdk is 26).
         Keep both definitions in sync. Theme.PermissionInspector.Dark inherits from this. -->
    <style name="Theme.PermissionInspector" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorTertiary">@color/brand_accent</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
